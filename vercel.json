{
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/p/:id",
      "destination": "/api/p?id=:id"
    },
    {
      "source": "/api/p-image/:id",
      "destination": "/api/p-image?id=:id"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
