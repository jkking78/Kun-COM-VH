{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Firestore Database Schema - Département Communication (Kun COM VH)",
  "description": "Validation Schema for Firestore Collections in the Church Communication Management Application",
  "type": "object",
  "definitions": {
    "User": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "ID unique de l'utilisateur (UID Firebase Auth)" },
        "nom": { "type": "string", "minLength": 2, "maxLength": 100 },
        "email": { "type": "string", "format": "email" },
        "photo_url": { "type": ["string", "null"], "format": "uri" },
        "section_id": { "type": ["string", "null"], "description": "Référence à la collection SECTIONS (ex: Web, Projection, Prod, Regie, Cadrage, Photo, Vente)" },
        "role": {
          "type": "string",
          "enum": ["GRAND_RESPONSABLE", "RESP_SECTION", "MEMBRE", "STAGIAIRE"],
          "default": "STAGIAIRE"
        },
        "trust_score": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 100.0,
          "default": 100.0
        },
        "is_stagiaire_badge": { "type": "boolean", "default": false },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "nom", "email", "role", "trust_score", "is_stagiaire_badge"]
    },
    "Section": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nom": {
          "type": "string",
          "enum": ["Web", "Projection", "Prod", "Regie", "Cadrage", "Photo", "Vente"]
        },
        "icon_name": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["id", "nom", "icon_name"]
    },
    "ServiceCulte": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "num_culte": { "type": "integer", "enum": [1, 2, 3] },
        "statut": {
          "type": "string",
          "enum": ["A_VENIR", "EN_COURS", "CLOTURE"],
          "default": "A_VENIR"
        },
        "responsable_cloture_id": { "type": ["string", "null"] },
        "timestamp_cloture": { "type": ["string", "null"], "format": "date-time" }
      },
      "required": ["id", "date", "num_culte", "statut"]
    },
    "Debriefing": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "service_culte_id": { "type": "string" },
        "section_id": { "type": "string" },
        "user_id": { "type": "string" },
        "points_forts": {
          "type": "array",
          "items": { "type": "string" }
        },
        "points_amelioration": {
          "type": "array",
          "items": { "type": "string" }
        },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "service_culte_id", "section_id", "user_id", "points_forts", "points_amelioration", "timestamp"]
    },
    "Resolution": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "section_id": { "type": "string" },
        "libelle": { "type": "string", "minLength": 3 },
        "statut": {
          "type": "string",
          "enum": ["EN_COURS", "REALISE"],
          "default": "EN_COURS"
        },
        "avancement": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 0
        }
      },
      "required": ["id", "section_id", "libelle", "statut", "avancement"]
    },
    "NoteSection": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "service_culte_id": { "type": "string" },
        "section_cible_id": { "type": "string" },
        "notateur_id": { "type": "string" },
        "note_valeur": {
          "type": "number",
          "minimum": 1.0,
          "maximum": 5.0
        },
        "poids_note": {
          "type": "integer",
          "enum": [1, 3, 5],
          "description": "Poids attribué selon le rôle du notateur: 1 pour MEMBRE/STAGIAIRE, 3 pour RESP_SECTION, 5 pour GRAND_RESPONSABLE"
        },
        "is_confidentiel": {
          "type": "boolean",
          "description": "True si émise par un responsable/admin, False si membre"
        }
      },
      "required": ["id", "service_culte_id", "section_cible_id", "notateur_id", "note_valeur", "poids_note", "is_confidentiel"]
    },
    "BilanFeed": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "service_culte_id": { "type": "string" },
        "section_vedette_id": { "type": "string" },
        "publication_timestamp": { "type": "string", "format": "date-time" },
        "expiration_timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "Horodatage calculé automatiquement (publication_timestamp + 24 heures)"
        },
        "valide_par_admin": { "type": "boolean", "default": false }
      },
      "required": ["id", "service_culte_id", "section_vedette_id", "publication_timestamp", "expiration_timestamp", "valide_par_admin"]
    }
  },
  "properties": {
    "users": {
      "type": "array",
      "items": { "$ref": "#/definitions/User" }
    },
    "sections": {
      "type": "array",
      "items": { "$ref": "#/definitions/Section" }
    },
    "services_cultes": {
      "type": "array",
      "items": { "$ref": "#/definitions/ServiceCulte" }
    },
    "debriefings": {
      "type": "array",
      "items": { "$ref": "#/definitions/Debriefing" }
    },
    "resolutions": {
      "type": "array",
      "items": { "$ref": "#/definitions/Resolution" }
    },
    "notes_section": {
      "type": "array",
      "items": { "$ref": "#/definitions/NoteSection" }
    },
    "bilan_feed": {
      "type": "array",
      "items": { "$ref": "#/definitions/BilanFeed" }
    }
  }
}
